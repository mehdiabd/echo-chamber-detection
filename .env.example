# Copy to .env and fill in values: cp .env.example .env

# LLM naming (Synappse / org key). Set false to skip remote/local LLMs.
SYNAPPSE_API_KEY=
ORG_LLM_API_KEY=
ENABLE_LLM_NAMING=true
OLLAMA_HOST=http://host.docker.internal:11434
LOCAL_LLM_MODEL=llama3.1

# Optional LLM URL overrides
# ORG_LLM_URL=https://api.synappse.ir/api/chat/v1/chat/completions
# ORG_LLM_SELF_HOSTED_MODELS_URL=http://192.168.59.239:8002/v1/models
# ORG_LLM_SELF_HOSTED_CHAT_URL=http://192.168.59.239:8002/v1/chat/completions

# Elasticsearch fetch (make docker-elastic / POST /api/v1/pipeline/runs with fetch=true)
# Host must be on the org LAN/VPN. Copy the CA next to elastic.py (*.crt is gitignored).
# Auth 1 → https://192.168.59.79:9200 + ca.crt
# Auth 2 → https://192.168.59.26:9200 + http_ca.crt
ELASTIC_AUTH=1
# Optional: absolute path to the CA. If missing, fetch skips TLS verify.
# ELASTIC_CA_CERT=/app/ca.crt
# ELASTIC_VERIFY_CERTS=true
TOPIC_LABEL=
TOPIC_QUERY=
START_DATE=
END_DATE=
LOOKBACK_DAYS=14
MAX_SCAN_DOCS=0

# Party-change / Echo Chamber API (compose sets host/port/db for the api service)
PARTY_CHANGE_API_TOKEN=
PARTY_CHANGE_RETENTION_DAYS=365
PARTY_CHANGE_MAX_EVENTS=100000
ECHO_API_TOKEN=

# Pipeline knobs
# TOPIC_LABEL_OVERRIDE=
# COMMUNITY_RANDOM_SEED=42
# NODE2VEC_WORKERS=1
